    {"id":"title","type":"text","x":40,"y":20,"width":1450,"height":75,"text":"Knowledge workbench: implemented architecture","originalText":"Knowledge workbench: implemented architecture","fontSize":30,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top","lineHeight":1.25},
